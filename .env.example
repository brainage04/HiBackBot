DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id
# Optional: deploy the slash commands to this server only. Leave empty to deploy globally.
GUILD_ID=

# Optional: where backups are stored (default: data/ in the project)
# DATA_DIR=/var/lib/hibackbot

# error | warn | info | debug
LOG_LEVEL=info
# true: log each member's scan decision for /setallback (needs LOG_LEVEL=debug)
LOG_MEMBER_DETAILS=false
